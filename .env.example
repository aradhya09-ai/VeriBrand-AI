# VeriBrand AI — environment example
# Copy to `.env` and fill in values. NEVER commit real secrets.

# ---- Frontend ----
# Base URL of the FastAPI backend. Leave empty to run fully in local demo mode
# (browser-only persistence + deterministic rule engine, no live AI calls).
VITE_API_BASE_URL=

# Public, non-secret flag that shows the demo workspace banner in the UI.
VITE_DEMO_MODE=true

# ---- Backend (backend/.env) ----
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/veribrand
# SECRET_KEY=change-me-to-a-long-random-string
# CORS_ORIGINS=http://localhost:5173
#
# AI provider (optional). When unset, audits run on the deterministic rule
# engine and the UI labels results accordingly — nothing pretends to be AI.
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=60
#
# Storage (optional)
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_MB=10
